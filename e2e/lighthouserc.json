{
  "ci": {
    "collect": {
      "url": ["http://localhost:18080/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "resource-summary:script:size": ["error", { "maxNumericValue": 650000 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 60000 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 500000 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 200000 }],
        "resource-summary:document:size": ["error", { "maxNumericValue": 200000 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 1200000 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],
        "resource-summary:total:count": ["warn", { "maxNumericValue": 60 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-results"
    }
  }
}
