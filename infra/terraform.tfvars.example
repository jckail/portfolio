# Copy to terraform.tfvars (git-ignored) and fill in real values,
# or provide them via TF_VAR_* environment variables in CI.

project_id          = "portfolio-383615"
region              = "us-central1"
service_name        = "quickresume"
artifact_repository = "portfolio"
image_tag           = "REPLACE_WITH_CURRENT_40_CHARACTER_COMMIT_SHA"

# Enables keyless GitHub Actions deploys (WIF); see DEPLOYMENT.md
github_repository = "jckail/portfolio"

admin_email     = "admin@example.com"
resume_file     = "JordanKailResume.pdf"
allowed_origins = "https://www.jckail.com"
production_url  = "https://www.jckail.com"

# Read version IDs from the deployed revision. These are examples only.
# No credential values belong in Terraform inputs or state.
secret_versions = {
  SUPABASE_URL          = "1"
  SUPABASE_ANON_KEY     = "1"
  SUPABASE_SERVICE_ROLE = "1"
  ANTHROPIC_API_KEY     = "1"
  SENDGRID_API_KEY      = "1"
  CONTACT_PHONE        = "1"
  AGENT_ACCESS_SECRET  = "1"
  VERTEX_API_KEY       = "1"
}

# Optional: observability and spend guardrails (see infra/README.md)
# artifact_cleanup_dry_run  = true   # set false only after reviewing the dry-run log
# extra_uptime_hosts        = ["jckail.com", "jordan-kail.com", "www.jordan-kail.com"]
# billing_account_id        = ""     # set to create budgets; needs billing.budgets.create
# vertex_budget_service_ids = []     # catalog ids of Vertex AI / Generative Language
