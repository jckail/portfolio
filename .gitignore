# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/.eslintcache
frontend/.stylelintcache
frontend/coverage/
frontend/*.local
samplefrontend/node_modules/*

# E2E
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/lhci-results/
e2e/.lighthouseci/

# Environment variables
.env
.env.*
.venv/

# Terraform
infra/.terraform/
# infra/.terraform.lock.hcl is intentionally COMMITTED: it pins provider
# versions and their hashes, so `terraform init` is reproducible and a
# tampered provider release is caught. Same rationale as package-lock.json.
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfvars
!infra/terraform.tfvars.example
infra/crash.log
infra/tfplan*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak

# OS specific
.DS_Store
Thumbs.db

# Logs
backend/app/logs/
frontend/frontend.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Project specific
.notes.txt
.ignorefolder/
.aider*

cline_docs*

backend/app/utils/startup_logs/*

openai-chatgpt-latest.vsix

