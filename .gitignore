# Python backend
.venv/
venv/
# Any local virtualenv. .security-venv/ was previously excluded only by
# .git/info/exclude, which is local-only: on a fresh clone a `git add -A`
# would have committed ~100 MB of virtualenv.
*venv/
.security-venv/
.streamlit/secrets.toml
.streamlit/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
