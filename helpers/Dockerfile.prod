# Production Dockerfile
FROM node:22-alpine AS frontend-build

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./

# Build frontend with production configuration
ENV NODE_ENV=production
RUN npm run build

# Backend setup
# Patch version intentionally unpinned so the base image tracks Debian's
# latest security-patched slim build (python minor version stays pinned).
FROM python:3.12-slim
WORKDIR /app

# Copy the frontend build
COPY --from=frontend-build /app/frontend/dist/ /app/frontend/dist/

# Create directory for favicon files
RUN mkdir -p /app/frontend/dist/public/

# Copy favicon files (if they exist)
COPY --from=frontend-build /app/frontend/public/favicon* /app/frontend/dist/public/

# Install backend dependencies from the fully-pinned, hash-verified
# lockfile (requirements.lock.txt, regenerated via
# `helpers/compile-requirements.sh`) for reproducible builds. Also pins
# setuptools/wheel: CVE-2024-6345, CVE-2025-47273, CVE-2026-24049.
COPY requirements.lock.txt .
RUN pip install --no-cache-dir --upgrade "pip>=25" "setuptools>=78.1.1" "wheel>=0.46.2" \
    && pip install --no-cache-dir --require-hashes -r requirements.lock.txt \
    && pip check \
    # Installers are build-only dependencies. Remove their vendored packages
    # (including pip's msgpack) and ensurepip's bundled installer from runtime.
    && pip uninstall --yes pip setuptools wheel \
    && rm -rf /usr/local/lib/python3.12/ensurepip

# Copy the backend code
COPY backend /app/backend/

# Set environment variables
ENV PYTHONPATH=/app \
    NODE_ENV=production \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Entry point script
COPY <<EOF /app/start.sh
#!/bin/sh
echo "Starting production environment..."
echo "Checking environment variables..."

# List of required environment variables
required_vars="SUPABASE_URL SUPABASE_ANON_KEY SUPABASE_SERVICE_ROLE ALLOWED_ORIGINS PRODUCTION_URL ADMIN_EMAIL RESUME_FILE ANTHROPIC_API_KEY SENDGRID_API_KEY"

# Check each required variable
for var in \$required_vars; do
    if [ -z "\$(eval echo \\\$\${var})" ]; then
        echo "Error: Required environment variable \$var is not set"
        exit 1
    fi
done

echo "Environment check passed"
# --ws-max-size bounds a WebSocket frame before receive_text() buffers it;
# the default is 16 MiB, which a handful of sockets can turn into an OOM on
# a 512Mi instance. Application-level caps only apply after parsing.
exec uvicorn backend.app.main:app --host 0.0.0.0 --port \${PORT:-8080} \\
    --ws-max-size 65536 --h11-max-incomplete-event-size 16384
EOF

RUN chmod +x /app/start.sh

# Drop root. Cloud Run honours the image user, so an RCE in FastAPI/uvicorn or
# any dependency would otherwise land as UID 0 with write access to /app.
# Numeric form so the runtime never needs /etc/passwd resolution.
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --no-create-home app \
    && chown -R app:app /app
USER 10001:10001

CMD ["/app/start.sh"]
